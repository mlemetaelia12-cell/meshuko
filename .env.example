# Neon PostgreSQL pooled connection string. Keep this server-side only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Admin credentials. There is no public signup page.
ADMIN_EMAIL=owner@meshukosfarm.co.tz
ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum

# Use a long random string (at least 32 characters). Example generation:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Used only for the public farm contact CTA. Defaults are already set in app config.
FARM_WHATSAPP=255783872819
BRELL_EMAIL=buildwebtz@gmail.com
BRELL_WHATSAPP=255784452159
NEXT_PUBLIC_SITE_URL=http://localhost:3000
